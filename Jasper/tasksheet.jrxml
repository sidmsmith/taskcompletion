<?xml version="1.0" encoding="UTF-8"?>
<!-- WMS DEPLOYMENT COPY - classic JRXML syntax for MAWM's JasperReports 6.4.0.
     Follows the same conventions as Jasper/cyclecountsheet.jrxml - see
     Jasper/README.md before changing the query language/data-source lines
     (language="jsonql" + JsonQLDataSource, no ".*" on subDataSource() calls,
     no <sortField> on a subDataset something else needs a live cursor into -
     see "sortField regression" in README.md) or the classic-format syntax
     rules ("Classic JRXML syntax notes"). Never open/save this file in
     Jaspersoft Studio - it will silently rewrite it into the newer format
     and break it.

     FIRST REAL DRAFT (2026-08-11), built from two real captured TASK_SHEET
     payload samples (one plain PICK_INTO_OLPN task, one PICK_INTO_CART
     hybrid task) - see chat history for the full field-by-field reasoning.
     NOT YET RENDER-TESTED as of writing this comment - see README.md's
     Task Sheet section once that's done for what's actually confirmed.

     Real payload shape: {"Data": [ {TaskId, TransactionId, ...,
     TaskDetail: [ {SourceLocationId, ItemId, Quantity, UomTypeId,
     PlannedContainerTypeId, OlpnId, PlannedSlotId, PickExecutionSequence,
     Sequence, ...}, ... ]}, ... ]} - same "Data" root envelope pattern as
     cyclecountsheet.jrxml, same fix (empty root query + jr:list over
     "Data", no ".*"). The payload ALSO duplicates this whole array under
     TransformedPayload.Data - deliberately never referenced here, which is
     the entire de-dup fix (nothing to de-dup if it's never read).

     ItemDescription does not exist in the real payload yet (confirmed by
     the user) - hardcoded as "Item " + ItemId + " Description" until it's
     added; same placeholder treatment for oLPN Type/Size, hardcoded to the
     literal text "TYPE/SIZE" (also confirmed absent from the real payload).

     Sort key for pick-line walk order: PickExecutionSequence is NOT
     populated for every task (confirmed null on every line of a real
     PICK_INTO_CART task, populated on a real PICK_INTO_OLPN task) - falls
     back to the plain TaskDetail array-position field "Sequence" when
     null. See the EffectiveSequence variable below.

     Container legend: v1 deliberately does NOT de-duplicate repeated
     destinations (e.g. two lines sharing one cart slot/tote print two
     legend lines, not one) - a real de-dup mechanism (sort + suppress
     consecutive duplicates) was designed but deliberately deferred to a
     separate, independently-testable follow-up change rather than
     stacking multiple unproven mechanisms into one untested draft - see
     the sortField regression note above for exactly why that caution
     exists in this project. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xmlns:jr="http://jasperreports.sourceforge.net/jasperreports/components"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd
                                  http://jasperreports.sourceforge.net/jasperreports/components http://jasperreports.sourceforge.net/xsd/components.xsd
                                  http://jasperreports.sourceforge.net/jasperreports/components http://jasperreports.sourceforge.net/xsd/barcode4j.xsd"
              name="task_sheet_report"
              pageWidth="612"
              pageHeight="792"
              columnWidth="540"
              leftMargin="36"
              rightMargin="36"
              topMargin="36"
              bottomMargin="36">

    <property name="net.sf.jasperreports.export.pdf.metadata.title" value="Pick Sheet"/>

    <style name="ReportTitle" fontName="SansSerif" fontSize="16" isBold="true" forecolor="#17365D"/>
    <style name="TaskHeader" fontName="SansSerif" fontSize="11" isBold="true" forecolor="#FFFFFF"/>
    <style name="ColumnHeader" fontName="SansSerif" fontSize="9" isBold="true" forecolor="#FFFFFF"/>
    <style name="Detail" fontName="SansSerif" fontSize="9"/>
    <style name="Legend" fontName="SansSerif" fontSize="9"/>

    <!-- One row per pick line, sorted by walk sequence. Independent
         subDataset from LegendLineDataset below even though both read the
         same "TaskDetail" array - each needs its own sort order, and a
         subDataset only supports one sortField set. -->
    <subDataset name="PickLineDataset" uuid="b6808b95-62a7-49bd-b343-33af64662c26">
        <field name="SourceLocationId" class="java.lang.String">
            <property name="net.sf.jasperreports.jsonql.field.expression" value="SourceLocationId"/>
        </field>
        <field name="ItemId" class="java.lang.String">
            <property name="net.sf.jasperreports.jsonql.field.expression" value="ItemId"/>
        </field>
        <field name="Quantity" class="java.lang.Double">
            <property name="net.sf.jasperreports.jsonql.field.expression" value="Quantity"/>
        </field>
        <field name="UomTypeId" class="java.lang.String">
            <property name="net.sf.jasperreports.jsonql.field.expression" value="UomTypeId"/>
        </field>
        <field name="PlannedContainerTypeId" class="java.lang.String">
            <property name="net.sf.jasperreports.jsonql.field.expression" value="PlannedContainerTypeId"/>
        </field>
        <field name="OlpnId" class="java.lang.String">
            <property name="net.sf.jasperreports.jsonql.field.expression" value="OlpnId"/>
        </field>
        <field name="PlannedSlotId" class="java.lang.String">
            <property name="net.sf.jasperreports.jsonql.field.expression" value="PlannedSlotId"/>
        </field>
        <field name="PickExecutionSequence" class="java.lang.String">
            <property name="net.sf.jasperreports.jsonql.field.expression" value="PickExecutionSequence"/>
        </field>
        <field name="Sequence" class="java.lang.Integer">
            <property name="net.sf.jasperreports.jsonql.field.expression" value="Sequence"/>
        </field>
        <sortField name="EffectiveSequence" type="Variable" order="Ascending"/>
        <variable name="EffectiveSequence" class="java.lang.Integer" resetType="None" calculation="Nothing">
            <variableExpression><![CDATA[($F{PickExecutionSequence} != null && !$F{PickExecutionSequence}.trim().isEmpty()) ? Integer.valueOf($F{PickExecutionSequence}.trim()) : $F{Sequence}]]></variableExpression>
        </variable>
    </subDataset>

    <!-- One row per Task - the outer jr:list's own subDataset. -->
    <subDataset name="TaskDataset" uuid="234cf7b5-5555-4d9c-8224-dc12078e9d00">
        <field name="TaskId" class="java.lang.String">
            <property name="net.sf.jasperreports.jsonql.field.expression" value="TaskId"/>
        </field>
        <field name="TransactionId" class="java.lang.String">
            <property name="net.sf.jasperreports.jsonql.field.expression" value="TransactionId"/>
        </field>
    </subDataset>

    <!-- One row per TaskDetail record describing that record's own
         destination - v1, no de-dup (see the file-level comment above). -->
    <subDataset name="LegendLineDataset" uuid="7d3ea365-1e60-4a14-89f5-42e5fedb8d83">
        <field name="PlannedContainerTypeId" class="java.lang.String">
            <property name="net.sf.jasperreports.jsonql.field.expression" value="PlannedContainerTypeId"/>
        </field>
        <field name="OlpnId" class="java.lang.String">
            <property name="net.sf.jasperreports.jsonql.field.expression" value="OlpnId"/>
        </field>
        <field name="PlannedSlotId" class="java.lang.String">
            <property name="net.sf.jasperreports.jsonql.field.expression" value="PlannedSlotId"/>
        </field>
        <sortField name="PlannedSlotId" order="Ascending"/>
    </subDataset>

    <parameter name="REPORT_TITLE" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["Pick Sheet"]]></defaultValueExpression>
    </parameter>

    <queryString language="jsonql">
        <![CDATA[]]>
    </queryString>

    <title>
        <band height="60" splitType="Stretch">
            <textField>
                <reportElement x="0" y="0" width="540" height="60" uuid="f13ec62f-c007-4368-9793-292d1a00f331"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="21" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{REPORT_TITLE}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <detail>
        <band height="280" splitType="Stretch">
            <componentElement>
                <reportElement x="0" y="0" width="540" height="280" uuid="00b92faf-3460-4b71-9f5a-65606e6648f1"/>
                <jr:list printOrder="Vertical">
                    <datasetRun subDataset="TaskDataset" uuid="9a8fa396-a436-4d1a-8a42-cbc504bd189f">
                        <dataSourceExpression><![CDATA[((net.sf.jasperreports.engine.data.JsonQLDataSource)$P{REPORT_DATA_SOURCE}).subDataSource("Data")]]></dataSourceExpression>
                    </datasetRun>
                    <jr:listContents height="186" width="540">

                        <!-- No forced page break between tasks - <break>
                             inside jr:listContents throws a real
                             NullPointerException on this engine (this.band
                             is null in JRFillBreak.prepare()) - confirmed
                             live via the local harness, not a guess. A real
                             fix needs a <subreport> (only report-level
                             structures, not list/table components, honor
                             their subDataset's own <group
                             isStartNewPage="true">), which would require a
                             second linked file MAWM's deployment mechanism
                             has never been confirmed to support - deferred
                             per explicit instruction ("this is all demo
                             stuff... just do what you think is right and we
                             can revisit actual break logic later"). This
                             20pt gap plus the bold banner below is the
                             interim substitute - visually clear, but tasks
                             can still land on the same physical page. -->
                        <rectangle>
                            <reportElement x="0" y="20" width="540" height="25" backcolor="#17365D" mode="Opaque" uuid="234cf7b5-ecc5-4d9c-8224-dc12078e9daf"/>
                        </rectangle>
                        <textField>
                            <reportElement style="TaskHeader" x="10" y="23" width="520" height="19" uuid="9eafc119-a0c9-430b-983d-9a1ed08249af"/>
                            <textFieldExpression><![CDATA["Task: " + $F{TaskId} + ($F{TransactionId} == null ? "" : "   " + $F{TransactionId})]]></textFieldExpression>
                        </textField>

                        <componentElement>
                            <reportElement x="446" y="48" width="64" height="64" uuid="ab69a230-b5ec-4ce6-80d7-117ab1f5d81a"/>
                            <jr:QRCode>
                                <jr:codeExpression><![CDATA[$F{TaskId}]]></jr:codeExpression>
                            </jr:QRCode>
                        </componentElement>

                        <staticText>
                            <reportElement x="0" y="49" width="200" height="14" uuid="cc30fdf3-e005-48f7-8c19-9bccdb89d878"/>
                            <textElement>
                                <font fontName="SansSerif" size="8" isBold="true"/>
                            </textElement>
                            <text><![CDATA[Containers for this task:]]></text>
                        </staticText>

                        <componentElement>
                            <reportElement x="0" y="64" width="440" height="40" uuid="aa075256-3c89-496c-8aaf-dab2db4376e9"/>
                            <jr:list printOrder="Vertical">
                                <datasetRun subDataset="LegendLineDataset" uuid="6d6f89a3-516b-4647-b92b-8f98eb44dc69">
                                    <dataSourceExpression><![CDATA[((net.sf.jasperreports.engine.data.JsonQLDataSource)$P{REPORT_DATA_SOURCE}).subDataSource("TaskDetail")]]></dataSourceExpression>
                                </datasetRun>
                                <jr:listContents height="14" width="440">
                                    <textField>
                                        <reportElement style="Legend" x="0" y="0" width="440" height="14" uuid="9440cdb1-8462-4340-9a4b-0252be540111"/>
                                        <textFieldExpression><![CDATA[
                                            ($F{PlannedSlotId} != null && !$F{PlannedSlotId}.trim().isEmpty() ? "Slot " + $F{PlannedSlotId} + "   " : "")
                                            + ("TOTE".equals($F{PlannedContainerTypeId})
                                                ? "Tote ID: ______________________"
                                                : "oLPN " + $F{OlpnId} + "   TYPE/SIZE")
                                        ]]></textFieldExpression>
                                    </textField>
                                </jr:listContents>
                            </jr:list>
                        </componentElement>

                        <componentElement>
                            <reportElement x="0" y="114" width="540" height="24" uuid="4bfe38a2-5de9-4beb-8748-07867f7e8517"/>
                            <jr:table>
                                <datasetRun subDataset="PickLineDataset" uuid="c526fc8e-e1dc-4a30-a0a1-761eed18ca56">
                                    <dataSourceExpression><![CDATA[((net.sf.jasperreports.engine.data.JsonQLDataSource)$P{REPORT_DATA_SOURCE}).subDataSource("TaskDetail")]]></dataSourceExpression>
                                </datasetRun>

                                <jr:column width="80" uuid="90a2ce75-a63a-4819-815c-0e1b3aaf2d5e">
                                    <jr:columnHeader height="20">
                                        <rectangle>
                                            <reportElement x="0" y="0" width="80" height="20" backcolor="#5B9BD5" mode="Opaque" uuid="16d6103f-ae43-415d-8dfb-348dcdf6879a"/>
                                            <graphicElement><pen lineWidth="0.0"/></graphicElement>
                                        </rectangle>
                                        <staticText>
                                            <reportElement style="ColumnHeader" x="4" y="0" width="76" height="20" uuid="1d90548a-68d5-4874-9a44-df0b0d09ba29"/>
                                            <textElement verticalAlignment="Middle"/>
                                            <text><![CDATA[Location]]></text>
                                        </staticText>
                                    </jr:columnHeader>
                                    <jr:detailCell height="24">
                                        <textField isStretchWithOverflow="true">
                                            <reportElement style="Detail" x="4" y="0" width="76" height="24" uuid="5e9c43db-07e0-432f-93c1-d573ec499c98"/>
                                            <textElement verticalAlignment="Middle"/>
                                            <textFieldExpression><![CDATA[$F{SourceLocationId}]]></textFieldExpression>
                                        </textField>
                                    </jr:detailCell>
                                </jr:column>

                                <jr:column width="72" uuid="bc6d2d87-7ce9-49ee-bb7e-d08246f81d43">
                                    <jr:columnHeader height="20">
                                        <rectangle>
                                            <reportElement x="0" y="0" width="72" height="20" backcolor="#5B9BD5" mode="Opaque" uuid="2b662a3f-2a22-4ee1-964e-627e6e4a2e60"/>
                                            <graphicElement><pen lineWidth="0.0"/></graphicElement>
                                        </rectangle>
                                        <staticText>
                                            <reportElement style="ColumnHeader" x="4" y="0" width="68" height="20" uuid="1df4db8c-2f9d-4ba8-92f0-fa94eb9f67e7"/>
                                            <textElement verticalAlignment="Middle"/>
                                            <text><![CDATA[Dest.]]></text>
                                        </staticText>
                                    </jr:columnHeader>
                                    <jr:detailCell height="24">
                                        <textField isStretchWithOverflow="true">
                                            <reportElement style="Detail" x="4" y="0" width="68" height="24" uuid="fa92697e-6a37-42db-ae1a-1221e6df40c3"/>
                                            <textElement verticalAlignment="Middle"/>
                                            <textFieldExpression><![CDATA[
                                                $F{PlannedSlotId} != null && !$F{PlannedSlotId}.trim().isEmpty()
                                                    ? "Slot " + $F{PlannedSlotId}
                                                    : ("TOTE".equals($F{PlannedContainerTypeId})
                                                        ? "TOTE"
                                                        : ($F{OlpnId} != null && $F{OlpnId}.length() > 6
                                                            ? $F{OlpnId}.substring(0, 2) + "..." + $F{OlpnId}.substring($F{OlpnId}.length() - 4)
                                                            : $F{OlpnId}))
                                            ]]></textFieldExpression>
                                        </textField>
                                    </jr:detailCell>
                                </jr:column>

                                <jr:column width="70" uuid="99b7f20f-27f0-44bb-b15b-8ebf8c83190f">
                                    <jr:columnHeader height="20">
                                        <rectangle>
                                            <reportElement x="0" y="0" width="70" height="20" backcolor="#5B9BD5" mode="Opaque" uuid="1cab55e1-f93c-40cd-9095-ee326dbc0f5d"/>
                                            <graphicElement><pen lineWidth="0.0"/></graphicElement>
                                        </rectangle>
                                        <staticText>
                                            <reportElement style="ColumnHeader" x="4" y="0" width="66" height="20" uuid="50692535-6995-4954-9512-a17ef1f46506"/>
                                            <textElement verticalAlignment="Middle"/>
                                            <text><![CDATA[Item]]></text>
                                        </staticText>
                                    </jr:columnHeader>
                                    <jr:detailCell height="24">
                                        <textField isStretchWithOverflow="true">
                                            <reportElement style="Detail" x="4" y="0" width="66" height="24" uuid="88cba219-785e-46e9-b145-baecbccd82d2"/>
                                            <textElement verticalAlignment="Middle"/>
                                            <textFieldExpression><![CDATA[$F{ItemId}]]></textFieldExpression>
                                        </textField>
                                    </jr:detailCell>
                                </jr:column>

                                <jr:column width="168" uuid="80ce7bbe-aeaf-4f66-ab5d-70f6cefcedd1">
                                    <jr:columnHeader height="20">
                                        <staticText>
                                            <reportElement style="ColumnHeader" mode="Opaque" x="0" y="0" width="168" height="20" backcolor="#5B9BD5" uuid="47903e51-9ca5-4913-98f5-53dc74a3a1f4"/>
                                            <textElement verticalAlignment="Middle"/>
                                            <text><![CDATA[Description]]></text>
                                        </staticText>
                                    </jr:columnHeader>
                                    <jr:detailCell height="24">
                                        <textField isStretchWithOverflow="true">
                                            <reportElement style="Detail" x="4" y="0" width="164" height="24" uuid="330beebe-d800-4a02-ad06-cd44600a452f"/>
                                            <textElement verticalAlignment="Middle"/>
                                            <textFieldExpression><![CDATA["Item " + $F{ItemId} + " Description"]]></textFieldExpression>
                                        </textField>
                                    </jr:detailCell>
                                </jr:column>

                                <jr:column width="70" uuid="c2d3e4f5-2222-4b1c-9d8e-3f4a5b6c7d8e">
                                    <jr:columnHeader height="20">
                                        <rectangle>
                                            <reportElement x="0" y="0" width="70" height="20" backcolor="#5B9BD5" mode="Opaque" uuid="d3e4f5a6-3333-4c2d-8e9f-4a5b6c7d8e9f"/>
                                            <graphicElement><pen lineWidth="0.0"/></graphicElement>
                                        </rectangle>
                                        <staticText>
                                            <reportElement style="ColumnHeader" x="4" y="0" width="66" height="20" uuid="e4f5a6b7-4444-4d3e-9f0a-5b6c7d8e9f0a"/>
                                            <textElement verticalAlignment="Middle"/>
                                            <text><![CDATA[Req. Qty]]></text>
                                        </staticText>
                                    </jr:columnHeader>
                                    <jr:detailCell height="24">
                                        <textField isStretchWithOverflow="true">
                                            <reportElement style="Detail" x="4" y="0" width="66" height="24" uuid="f5a6b7c8-5555-4e4f-a01b-6c7d8e9f0a1b"/>
                                            <textElement verticalAlignment="Middle"/>
                                            <textFieldExpression><![CDATA[new java.text.DecimalFormat("#,##0.##").format($F{Quantity}) + " " + ($F{UomTypeId} == null ? "" : $F{UomTypeId})]]></textFieldExpression>
                                        </textField>
                                    </jr:detailCell>
                                </jr:column>

                                <jr:column width="80" uuid="a6b7c8d9-6666-4f5a-b12c-7d8e9f0a1b2c">
                                    <jr:columnHeader height="20">
                                        <rectangle>
                                            <reportElement x="0" y="0" width="80" height="20" backcolor="#5B9BD5" mode="Opaque" uuid="b7c8d9e0-7777-4a6b-c23d-8e9f0a1b2c3d"/>
                                            <graphicElement><pen lineWidth="0.0"/></graphicElement>
                                        </rectangle>
                                        <staticText>
                                            <reportElement style="ColumnHeader" x="4" y="0" width="76" height="20" uuid="c8d9e0f1-8888-4b7c-d34e-9f0a1b2c3d4e"/>
                                            <textElement verticalAlignment="Middle"/>
                                            <text><![CDATA[Picked Qty]]></text>
                                        </staticText>
                                    </jr:columnHeader>
                                    <jr:detailCell height="24">
                                        <line>
                                            <reportElement x="4" y="18" width="72" height="1" uuid="d9e0f1a2-9999-4c8d-e45f-0a1b2c3d4e5f"/>
                                        </line>
                                    </jr:detailCell>
                                </jr:column>

                            </jr:table>
                        </componentElement>

                    </jr:listContents>
                </jr:list>
            </componentElement>
        </band>
    </detail>

    <pageFooter>
        <band height="18">
            <textField>
                <reportElement x="0" y="0" width="270" height="15" forecolor="#666666" uuid="a2b3c4d5-2222-4f10-1782-3a4b5c6d7e82"/>
                <textElement>
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            <textField pattern="yyyy-MM-dd HH:mm">
                <reportElement x="270" y="0" width="270" height="15" forecolor="#666666" uuid="b3c4d5e6-3333-4021-2893-4a5b6c7d8e93"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>
